{"metadata":{"kernelspec":{"language":"python","display_name":"Python 3","name":"python3"},"language_info":{"name":"python","version":"3.12.12","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"},"kaggle":{"accelerator":"none","dataSources":[{"sourceType":"datasetVersion","sourceId":16433332,"datasetId":10533555,"databundleVersionId":17431071}],"dockerImageVersionId":31328,"isInternetEnabled":true,"language":"python","sourceType":"notebook","isGpuEnabled":false}},"nbformat_minor":4,"nbformat":4,"cells":[{"cell_type":"code","source":"# 1. Instalacja Gradio\n!pip install -q gradio\n\nimport os\nimport gradio as gr\nimport numpy as np\nimport tensorflow as tf\n\n# 2. ŚCIEŻKA DO MODELU\nmodel_path = '/kaggle/input/datasets/jakkrol/dpf-2-1/deepfake_v2_1.keras'\n\nprint(\"Ładowanie modelu...\")\nloaded_model = tf.keras.models.load_model(\n    model_path,\n    custom_objects={'preprocess_input': tf.keras.applications.mobilenet_v2.preprocess_input}\n)\nprint(\"Model gotowy\")\n\ndef predict_deepfake_scan(img):\n    if img is None:\n        return \"Proszę wrzucić zdjęcie.\"\n\n    img_ready = np.array(img, dtype=np.float32)\n\n    h, w, _ = img_ready.shape\n    tile_size = 224\n    stride = 224  \n\n    all_scores = []\n\n    # Analiza kafelkowa 1:1\n    for y in range(0, h - tile_size + 1, stride):\n        for x in range(0, w - tile_size + 1, stride):\n            tile = img_ready[y:y+tile_size, x:x+tile_size]\n            if tile.shape[0] != tile_size or tile.shape[1] != tile_size:\n                continue\n            \n            tile_array = np.expand_dims(tile, axis=0)\n            prediction = loaded_model.predict(tile_array, verbose=0)\n            all_scores.append(prediction[0][0])\n\n    if not all_scores:\n        return \"Zdjęcie jest za małe na analizę kafelkową (minimum 224x224 px).\"\n\n    final_score = np.mean(all_scores)\n    \n    \n    threshold = 0.5\n\n    if final_score < threshold:\n        # Im bliżej zera, tym bardziej fake\n        confidence = (1 - final_score) * 100\n        return f\"WYKRYTO GENERACJĘ AI (Pewność: {confidence:.2f}%) [Wynik: {final_score:.4f}]\"\n    else:\n        # Im bliżej jedynki, tym bardziej legit\n        confidence = final_score * 100\n        return f\"PRAWDZIWE ZDJĘCIE (Pewność: {confidence:.2f}%) [Wynik: {final_score:.4f}]\"\n\n#INTERFEJS GRADIO\ninterface = gr.Interface(\n    fn=predict_deepfake_scan,\n    inputs=gr.Image(),\n    outputs=\"text\",\n    title=\"Wykrywacz Deepfake V2 (Pełna Skuteczność)\",\n    description=\"Skaner kafelkowy zsynchronizowany z surową przestrzenią liczbową modelu (0-255).\"\n)\n\n# Odpalam interfejs\ninterface.queue().launch(share=True, prevent_thread_lock=False)","metadata":{"_uuid":"8f2839f25d086af736a60e9eeb907d3b93b6e0e5","_cell_guid":"b1076dfc-b9ad-4769-8c92-a6c4dae69d19","trusted":true,"execution":{"iopub.status.busy":"2026-05-24T19:54:52.575063Z","iopub.execute_input":"2026-05-24T19:54:52.575455Z","iopub.status.idle":"2026-05-24T19:55:43.187073Z","shell.execute_reply.started":"2026-05-24T19:54:52.575416Z","shell.execute_reply":"2026-05-24T19:55:43.185365Z"}},"outputs":[{"name":"stderr","text":"2026-05-24 19:55:12.617312: E external/local_xla/xla/stream_executor/cuda/cuda_fft.cc:467] Unable to register cuFFT factory: Attempting to register factory for plugin cuFFT when one has already been registered\nWARNING: All log messages before absl::InitializeLog() is called are written to STDERR\nE0000 00:00:1779652512.861787      57 cuda_dnn.cc:8579] Unable to register cuDNN factory: Attempting to register factory for plugin cuDNN when one has already been registered\nE0000 00:00:1779652512.933824      57 cuda_blas.cc:1407] Unable to register cuBLAS factory: Attempting to register factory for plugin cuBLAS when one has already been registered\nW0000 00:00:1779652513.521202      57 computation_placer.cc:177] computation placer already regist