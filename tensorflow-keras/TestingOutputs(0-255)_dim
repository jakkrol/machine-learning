Im bliżej zera, tym bardziej fake\n        confidence = (1 - final_score) * 100\n        return f\"WYKRYTO GENERACJĘ AI (Pewność: {confidence:.2f}%) [Wynik: {final_score:.4f}]\"\n    else:\n        # Im bliżej jedynki, tym bardziej legit\n        confidence = final_score * 100\n        return f\"PRAWDZIWE ZDJĘCIE (Pewność: {confidence:.2f}%) [Wynik: {final_score:.4f}]\"\n\n#INTERFEJS GRADIO\ninterface = gr.Interface(\n    fn=predict_deepfake_scan,\n    inputs=gr.Image(),\n    outputs=\"text\",\n    title=\"Wykrywacz zdjęć generownych przez AI\",\n    description=\"Skan kafelkowy z surową przestrzenią (0-255).\"\n)\n\n# Odpalam interfejs\ninterface.queue().launch(share=True, prevent_thread_lock=False)","metadata":{"_uuid":"8f2839f25d086af736a60e9eeb907d3b93b6e0e5","_cell_guid":"b1076dfc-b9ad-4769-8c92-a6c4dae69d19","trusted":true,"execution":{"iopub.status.busy":"2026-05-25T10:22:56.433807Z","iopub.execute_input":"2026-05-25T10:22:56.434203Z","iopub.status.idle":"2026-05-25T10:23:47.278537Z","shell.execute_reply.started":"2026-05-25T10:22:56.434159Z","shell.execute_reply":"2026-05-25T10:23:47.27775Z"}},"outputs":[{"name":"stderr","text":"2026-05-25 10:23:15.784901: E external/local_xla/xla/stream_executor/cuda/cuda_fft.cc:467] Unable to register cuFFT factory: Attempting to register factory for plugin cuFFT when one has already been registered\nWARNING: All log messages before absl::InitializeLog() is called are written to STDERR\nE0000 00:00:1779704596.036583      57 cuda_dnn.cc:8579] Unable to register cuDNN factory: Attempting to register factory for plugin cuDNN when one has already been registered\nE0000 00:00:1779704596.111831      57 cuda_blas.cc:1407] Unable to register cuBLAS factory: Attempting to register factory for plugin cuBLAS when one has already been registered\nW0000 00:00:1779704596.695515      57 computation_placer.cc:177] computation placer already registered. Please check linkage and avoid linking the same target more than once.\nW0000 00:00:177